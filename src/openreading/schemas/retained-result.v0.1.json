{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openreading.ai/schemas/retained-result.v0.1.json",
  "$defs": {
    "JsonValue": {},
    "ResultContent": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "normalized_response"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "https://openreading.ai/schemas/response/v0.3.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "comparison_report"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "https://openreading.ai/schemas/comparison-report.v0.2.json"
              }
            }
          }
        }
      ],
      "description": "Complete normalized values with their producer identity, without backend_raw.",
      "properties": {
        "kind": {
          "enum": [
            "normalized_response",
            "comparison_report"
          ],
          "title": "Kind",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/ResultProvenance"
        },
        "payload": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "provenance",
        "payload"
      ],
      "title": "ResultContent",
      "type": "object"
    },
    "ResultProvenance": {
      "additionalProperties": false,
      "description": "Explicit producer assertions, with configuration values represented only by fingerprints.",
      "properties": {
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "core_version": {
          "minLength": 1,
          "title": "Core Version",
          "type": "string"
        },
        "core_commit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Core Commit"
        },
        "adapters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Adapters",
          "type": "object"
        },
        "source_sha256": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Sha256",
          "type": "array"
        },
        "subjects": {
          "additionalProperties": {
            "pattern": "^(or1|orr1)_[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Subjects",
          "type": "object"
        }
      },
      "required": [
        "request_sha256",
        "config_sha256",
        "core_version",
        "core_commit",
        "adapters",
        "source_sha256",
        "subjects"
      ],
      "title": "ResultProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "retained-result.v0.1",
      "default": "retained-result.v0.1",
      "title": "Format",
      "type": "string"
    },
    "input_grant_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Grant Sha256",
      "type": "string"
    },
    "content": {
      "$ref": "#/$defs/ResultContent"
    }
  },
  "required": [
    "input_grant_sha256",
    "content"
  ],
  "title": "ResultRecord",
  "type": "object"
}
