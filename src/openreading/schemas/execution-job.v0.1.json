{
  "$defs": {
    "ExecutionFault": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "execution_failed",
            "source_changed",
            "cancelled",
            "timeout",
            "os_permission_denied",
            "interrupted",
            "access_denied",
            "input_not_found",
            "storage_limit",
            "scope_denied",
            "invalid_request",
            "invalid_configuration"
          ],
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "ExecutionFault",
      "type": "object"
    },
    "ExecutionJob": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "queued"
              }
            }
          },
          "then": {
            "properties": {
              "stage": {
                "enum": [
                  "queued"
                ]
              },
              "receipt": {
                "type": "null"
              },
              "response_state": {
                "type": "null"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "running"
              }
            }
          },
          "then": {
            "properties": {
              "stage": {
                "enum": [
                  "executing",
                  "publishing"
                ]
              },
              "receipt": {
                "type": "null"
              },
              "response_state": {
                "type": "null"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "stage": {
                "enum": [
                  "complete"
                ]
              },
              "receipt": {
                "type": "object"
              },
              "response_state": {
                "type": "string"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "stage": {
                "enum": [
                  "stopped"
                ]
              },
              "receipt": {
                "type": "null"
              },
              "response_state": {
                "type": "null"
              },
              "error": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "properties": {
              "stage": {
                "enum": [
                  "stopped"
                ]
              },
              "receipt": {
                "type": "null"
              },
              "response_state": {
                "type": "null"
              },
              "error": {
                "type": "object"
              },
              "cancel_requested": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "properties": {
                  "kind": {
                    "const": "normalized_response"
                  }
                }
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "error": {
                "not": {
                  "properties": {
                    "code": {
                      "const": "cancelled"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "if": {
            "properties": {
              "state": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "properties": {
                  "code": {
                    "const": "cancelled"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "pattern": "^ej1_[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        },
        "stage": {
          "enum": [
            "queued",
            "executing",
            "publishing",
            "complete",
            "stopped"
          ],
          "title": "Stage",
          "type": "string"
        },
        "elapsed_seconds": {
          "minimum": 0,
          "title": "Elapsed Seconds",
          "type": "number"
        },
        "cancel_requested": {
          "default": false,
          "title": "Cancel Requested",
          "type": "boolean"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultReceipt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "response_state": {
          "anyOf": [
            {
              "enum": [
                "succeeded",
                "partial",
                "failed",
                "processing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response State"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionFault"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schema_version",
        "job_id",
        "state",
        "stage",
        "elapsed_seconds",
        "cancel_requested",
        "receipt",
        "response_state",
        "error"
      ],
      "title": "ExecutionJob",
      "type": "object"
    },
    "ExecutionJobCancel": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "pattern": "^ej1_[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "ExecutionJobCancel",
      "type": "object"
    },
    "ExecutionJobGet": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "pattern": "^ej1_[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        },
        "wait_seconds": {
          "default": 0,
          "maximum": 20,
          "minimum": 0,
          "title": "Wait Seconds",
          "type": "number"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "ExecutionJobGet",
      "type": "object"
    },
    "ExecutionJobList": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "jobs": {
          "items": {
            "$ref": "#/$defs/ExecutionJobSummary"
          },
          "maxItems": 50,
          "title": "Jobs",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        }
      },
      "required": [
        "jobs"
      ],
      "title": "ExecutionJobList",
      "type": "object"
    },
    "ExecutionJobListRequest": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        }
      },
      "title": "ExecutionJobListRequest",
      "type": "object"
    },
    "ExecutionJobSummary": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "pattern": "^ej1_[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "enum": [
                "queued",
                "running",
                "succeeded",
                "failed",
                "cancelled"
              ],
              "type": "string"
            },
            {
              "const": "unavailable",
              "type": "string"
            }
          ],
          "title": "State"
        },
        "elapsed_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Elapsed Seconds"
        }
      },
      "required": [
        "job_id",
        "state",
        "elapsed_seconds"
      ],
      "title": "ExecutionJobSummary",
      "type": "object"
    },
    "ResultReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "result_id": {
          "pattern": "^orr1_[0-9a-f]{64}$",
          "title": "Result Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "normalized_response",
            "comparison_report"
          ],
          "title": "Kind",
          "type": "string"
        },
        "content_bytes": {
          "minimum": 1,
          "title": "Content Bytes",
          "type": "integer"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "result_id",
        "kind",
        "content_bytes",
        "content_sha256"
      ],
      "title": "ResultReceipt",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/ExecutionJob"
    },
    {
      "$ref": "#/$defs/ExecutionJobList"
    },
    {
      "$ref": "#/$defs/ExecutionJobGet"
    },
    {
      "$ref": "#/$defs/ExecutionJobCancel"
    },
    {
      "$ref": "#/$defs/ExecutionJobListRequest"
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openreading.ai/schemas/execution-job.v0.1.json",
  "title": "OpenReading Execution Job v0.1"
}
