{
  "$defs": {
    "ExecutionFault": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "execution_failed",
            "source_changed",
            "cancelled",
            "timeout",
            "os_permission_denied",
            "interrupted",
            "access_denied",
            "input_not_found",
            "storage_limit",
            "scope_denied",
            "invalid_request",
            "invalid_configuration"
          ],
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "ExecutionFault",
      "type": "object"
    },
    "ExecutionJob": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "queued"
              }
            }
          },
          "then": {
            "properties": {
              "stage": {
                "enum": [
                  "queued"
                ]
              },
              "receipt": {
                "type": "null"
              },
              "response_state": {
                "type": "null"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "running"
              }
            }
          },
          "then": {
            "properties": {
              "stage": {
                "enum": [
                  "executing",
                  "publishing"
                ]
              },
              "receipt": {
                "type": "null"
              },
              "response_state": {
                "type": "null"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "stage": {
                "enum": [
                  "complete"
                ]
              },
              "receipt": {
                "type": "object"
              },
              "response_state": {
                "type": "string"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "stage": {
                "enum": [
                  "stopped"
                ]
              },
              "receipt": {
                "type": "null"
              },
              "response_state": {
                "type": "null"
              },
              "error": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "properties": {
              "stage": {
                "enum": [
                  "stopped"
                ]
              },
              "receipt": {
                "type": "null"
              },
              "response_state": {
                "type": "null"
              },
              "error": {
                "type": "object"
              },
              "cancel_requested": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "properties": {
                  "kind": {
                    "const": "normalized_response"
                  }
                }
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "error": {
                "not": {
                  "properties": {
                    "code": {
                      "const": "cancelled"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "if": {
            "properties": {
              "state": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "properties": {
                  "code": {
                    "const": "cancelled"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "pattern": "^ej1_[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        },
        "stage": {
          "enum": [
            "queued",
            "executing",
            "publishing",
            "complete",
            "stopped"
          ],
          "title": "Stage",
          "type": "string"
        },
        "elapsed_seconds": {
          "minimum": 0,
          "title": "Elapsed Seconds",
          "type": "number"
        },
        "cancel_requested": {
          "default": false,
          "title": "Cancel Requested",
          "type": "boolean"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultReceipt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "response_state": {
          "anyOf": [
            {
              "enum": [
                "succeeded",
                "partial",
                "failed",
                "processing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response State"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionFault"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schema_version",
        "job_id",
        "state",
        "stage",
        "elapsed_seconds",
        "cancel_requested",
        "receipt",
        "response_state",
        "error"
      ],
      "title": "ExecutionJob",
      "type": "object"
    },
    "ExecutionJobCancel": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "pattern": "^ej1_[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "ExecutionJobCancel",
      "type": "object"
    },
    "ExecutionJobGet": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "pattern": "^ej1_[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        },
        "wait_seconds": {
          "default": 0,
          "maximum": 20,
          "minimum": 0,
          "title": "Wait Seconds",
          "type": "number"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "ExecutionJobGet",
      "type": "object"
    },
    "ExecutionJobList": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "jobs": {
          "items": {
            "$ref": "#/$defs/ExecutionJobSummary"
          },
          "maxItems": 50,
          "title": "Jobs",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        }
      },
      "required": [
        "jobs"
      ],
      "title": "ExecutionJobList",
      "type": "object"
    },
    "ExecutionJobListRequest": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        }
      },
      "title": "ExecutionJobListRequest",
      "type": "object"
    },
    "ExecutionJobSummary": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "pattern": "^ej1_[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "enum": [
                "queued",
                "running",
                "succeeded",
                "failed",
                "cancelled"
              ],
              "type": "string"
            },
            {
              "const": "unavailable",
              "type": "string"
            }
          ],
          "title": "State"
        },
        "elapsed_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Elapsed Seconds"
        }
      },
      "required": [
        "job_id",
        "state",
        "elapsed_seconds"
      ],
      "title": "ExecutionJobSummary",
      "type": "object"
    },
    "ResultReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "result_id": {
          "pattern": "^orr1_[0-9a-f]{64}$",
          "title": "Result Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "normalized_response",
            "comparison_report"
          ],
          "title": "Kind",
          "type": "string"
        },
        "content_bytes": {
          "minimum": 1,
          "title": "Content Bytes",
          "type": "integer"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "result_id",
        "kind",
        "content_bytes",
        "content_sha256"
      ],
      "title": "ResultReceipt",
      "type": "object"
    },
    "ExecutionToolFault": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "execution_failed",
            "source_changed",
            "cancelled",
            "timeout",
            "os_permission_denied",
            "interrupted",
            "access_denied",
            "input_not_found",
            "storage_limit",
            "scope_denied",
            "invalid_request",
            "invalid_configuration",
            "job_not_found",
            "job_state_invalid",
            "job_start_failed",
            "response_too_large"
          ],
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "ExecutionToolFault",
      "type": "object"
    },
    "ToolError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "memory_limit",
            "worker_monitor_failed",
            "os_permission_denied",
            "configuration_required",
            "engine_identity_unavailable",
            "access_denied",
            "input_not_found",
            "unsupported_format",
            "password_required",
            "input_too_large",
            "extraction_too_large",
            "no_readable_text",
            "busy",
            "timeout",
            "cancelled",
            "storage_limit",
            "parse_failed",
            "artifact_not_found",
            "artifact_corrupt",
            "artifact_version_unsupported",
            "evidence_not_found",
            "invalid_cursor",
            "response_too_large"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 256,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ToolError",
      "type": "object"
    },
    "ParseRequest": {
      "title": "ParseRequest",
      "type": "object",
      "required": [
        "document",
        "backend"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.3"
        },
        "document": {
          "type": "object",
          "description": "A relative source reference beneath the operator's input grant.",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "mime_type": {
              "type": "string",
              "examples": [
                "application/pdf",
                "image/png",
                "image/tiff",
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
              ]
            },
            "filename": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        },
        "backend": {
          "type": "object",
          "required": [],
          "description": "Which backend to run, and how it is provisioned. Encodes the four BYO modes.",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ],
              "description": "A backend id, or `strategy:<name>`. `auto` is gone: it asked the engine to infer, and selection is now the backend you name, else policy.backends in order, else pymupdf."
            },
            "type": {
              "enum": [
                "hosted_api",
                "oss_library",
                "framework_loader",
                "self_hosted_model"
              ]
            },
            "operation": {
              "type": "string",
              "description": "Sub-operation when a backend has several. Textract: DetectDocumentText|AnalyzeDocument|AnalyzeExpense|AnalyzeID|AnalyzeLending. Docling: default|vlm. LlamaParse tier: fast|cost_effective|agentic|agentic_plus."
            },
            "version": {
              "type": "string",
              "description": "Pin the backend/model version (LlamaParse 'version', model weights tag, library version)."
            }
          }
        },
        "outputs": {
          "type": "object",
          "description": "Desired output channels. The adapter fills what the backend supports and reports the rest in response.warnings.",
          "additionalProperties": false,
          "properties": {
            "markdown": {
              "type": "boolean",
              "default": true
            },
            "text": {
              "type": "boolean",
              "default": true
            },
            "blocks": {
              "type": "boolean",
              "default": true,
              "description": "Reading-order typed blocks with optional bbox/confidence (the common spine). Impossible for pure typed-field APIs and un-prompted token-stream LLMs."
            },
            "typed_fields": {
              "type": "boolean",
              "default": false
            },
            "tables": {
              "enum": [
                "none",
                "cells",
                "markdown",
                "html"
              ],
              "default": "markdown"
            },
            "chunking": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "strategy": {
                  "enum": [
                    "none",
                    "by_page",
                    "by_title",
                    "by_section",
                    "by_similarity",
                    "fixed"
                  ],
                  "default": "none"
                },
                "max_characters": {
                  "type": "integer",
                  "minimum": 1
                },
                "overlap": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "include_backend_raw": {
              "type": "boolean",
              "default": true,
              "description": "Return the untouched native payload / serialized native object (see \u00a75). Off by default for high-volume callers who only want normalized."
            }
          }
        },
        "extraction_schema": {
          "type": "object",
          "description": "Custom typed extraction (P2/P6). A JSON Schema describing the fields to pull. Routed to /extract (Reducto, Chunkr), documents[].fields via queryFields (Azure), QUERIES (Textract, degraded), Structured Outputs (OpenAI/Gemini/Claude), document_annotation (Mistral). Backends that cannot do schema extraction return a warning.",
          "additionalProperties": false,
          "properties": {
            "json_schema": {
              "type": "object",
              "description": "Draft 2020-12 subset the target supports. Deliberately left open (no `properties`/`additionalProperties` of its own): this value IS an arbitrary caller-supplied JSON Schema, not a field this contract shapes (M12)."
            },
            "instructions": {
              "type": "string",
              "description": "System prompt / extraction guidance for LLM-based extractors."
            },
            "citations": {
              "type": "boolean",
              "default": false,
              "description": "Request per-field source grounding (page + bbox) where supported (Reducto, Chunkr, Claude page citations)."
            }
          }
        },
        "features": {
          "type": "object",
          "description": "Capability flags. Adapter maps to native toggles; unsupported flags \u2192 response.warnings, never a hard error.",
          "additionalProperties": false,
          "properties": {
            "ocr": {
              "enum": [
                "auto",
                "force",
                "off"
              ],
              "default": "auto",
              "description": "off = born-digital only (Docling do_ocr=False, pypdf/pymupdf). force = always rasterize+OCR."
            },
            "ocr_languages": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "ISO codes; e.g. ['en'] Tesseract, Textract 6 Latin only."
            },
            "layout": {
              "type": "boolean",
              "default": true
            },
            "reading_order": {
              "type": "boolean",
              "default": true
            },
            "tables": {
              "type": "boolean",
              "default": true
            },
            "forms_key_value": {
              "type": "boolean",
              "default": false
            },
            "figures_images": {
              "type": "boolean",
              "default": false
            },
            "signatures": {
              "type": "boolean",
              "default": false
            },
            "classification": {
              "type": "boolean",
              "default": false
            },
            "handwriting": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "pages": {
          "type": "object",
          "description": "Page selection. Normalizer applies 1-based inclusive ranges before/after backend call depending on whether the backend supports native page ranges.",
          "additionalProperties": false,
          "properties": {
            "ranges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "start"
                ]
              }
            },
            "max_pages": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "routing": {
          "type": "object",
          "description": "Hints for the router when backend.id is a class rather than a concrete backend, or for fallback.",
          "additionalProperties": false,
          "properties": {
            "doc_type_hint": {
              "enum": [
                "bank_statement",
                "paystub",
                "w2",
                "1003_loan_app",
                "1040_tax",
                "invoice",
                "id_document",
                "medical_form",
                "clinical_pdf",
                "generic"
              ]
            },
            "fallback": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Ordered backend ids to try if the primary fails or violates a compliance constraint."
            }
          }
        }
      }
    },
    "ExecutionToolFailure": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "error": {
          "$ref": "#/$defs/ExecutionToolFault"
        }
      },
      "required": [
        "error"
      ],
      "title": "ExecutionToolFailure",
      "type": "object"
    },
    "ErrorEnvelope": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.3",
          "default": "0.3",
          "title": "Schema Version",
          "type": "string"
        },
        "error": {
          "$ref": "#/$defs/ToolError"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorEnvelope",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/ExecutionJob"
    },
    {
      "$ref": "#/$defs/ExecutionJobList"
    },
    {
      "$ref": "#/$defs/ExecutionJobGet"
    },
    {
      "$ref": "#/$defs/ExecutionJobCancel"
    },
    {
      "$ref": "#/$defs/ExecutionJobListRequest"
    },
    {
      "$ref": "#/$defs/ParseRequest"
    },
    {
      "$ref": "#/$defs/ExecutionToolFailure"
    },
    {
      "$ref": "#/$defs/ErrorEnvelope"
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openreading.ai/schemas/execution-tool.v0.1.json",
  "title": "OpenReading Execution Tool v0.1"
}
