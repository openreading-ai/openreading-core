{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openreading.ai/schemas/selection-tool.v0.2.json",
  "title": "Local single-file or snapshot selection result",
  "oneOf": [
    {
      "$ref": "#/$defs/Receipt"
    },
    {
      "$ref": "#/$defs/Failure"
    },
    {
      "$ref": "#/$defs/SelectionPage"
    }
  ],
  "$defs": {
    "Request": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512,
          "default": null
        }
      },
      "additionalProperties": false
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "source_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "schema_version",
        "path",
        "display_name",
        "source_bytes"
      ]
    },
    "Failure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "selection_unavailable",
                "selection_cancelled",
                "selection_timeout",
                "selection_failed",
                "busy"
              ]
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ]
        }
      },
      "required": [
        "schema_version",
        "error"
      ]
    },
    "SelectionReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "display_name": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "source_bytes": {
          "exclusiveMinimum": 0,
          "title": "Source Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "display_name",
        "source_bytes"
      ],
      "title": "SelectionReceipt",
      "type": "object"
    },
    "SelectionPage": {
      "additionalProperties": false,
      "description": "A bounded page of copied references, never a live directory grant.",
      "properties": {
        "schema_version": {
          "const": "0.2",
          "default": "0.2",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_id": {
          "pattern": "^s1_[0-9a-f]{32}$",
          "title": "Selection Id",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/SelectionReceipt"
          },
          "maxItems": 16,
          "title": "Items",
          "type": "array"
        },
        "total_files": {
          "minimum": 0,
          "title": "Total Files",
          "type": "integer"
        },
        "total_bytes": {
          "minimum": 0,
          "title": "Total Bytes",
          "type": "integer"
        },
        "skipped": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "hidden",
              "package",
              "symlink",
              "unsupported",
              "duplicate",
              "special"
            ]
          },
          "title": "Skipped",
          "type": "object"
        },
        "next_cursor": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        }
      },
      "required": [
        "selection_id",
        "items",
        "total_files",
        "total_bytes",
        "skipped"
      ],
      "title": "SelectionPage",
      "type": "object"
    }
  }
}
