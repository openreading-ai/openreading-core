{
  "$defs": {
    "ErrorEnvelope": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.3",
          "default": "0.3",
          "title": "Schema Version",
          "type": "string"
        },
        "error": {
          "$ref": "#/$defs/ToolError"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorEnvelope",
      "type": "object"
    },
    "ExecutionToolFailure": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "error": {
          "$ref": "#/$defs/ExecutionToolFault"
        }
      },
      "required": [
        "error"
      ],
      "title": "ExecutionToolFailure",
      "type": "object"
    },
    "ExecutionToolFault": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "execution_failed",
            "source_changed",
            "cancelled",
            "timeout",
            "os_permission_denied",
            "interrupted",
            "access_denied",
            "input_not_found",
            "storage_limit",
            "scope_denied",
            "invalid_request",
            "invalid_configuration",
            "job_not_found",
            "job_state_invalid",
            "job_start_failed",
            "resume_unavailable",
            "response_too_large"
          ],
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "ExecutionToolFault",
      "type": "object"
    },
    "StrategyList": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "strategies": {
          "items": {
            "type": "string"
          },
          "title": "Strategies",
          "type": "array"
        }
      },
      "required": [
        "strategies"
      ],
      "title": "StrategyList",
      "type": "object"
    },
    "StrategyRequest": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "enum": [
            "list",
            "show",
            "normalize",
            "validate",
            "plan"
          ],
          "title": "Operation",
          "type": "string"
        },
        "strategy": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strategy"
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParseRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "operation"
      ],
      "title": "StrategyRequest",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "list"
              }
            }
          },
          "then": {
            "properties": {
              "strategy": {
                "type": "null"
              }
            }
          },
          "else": {
            "required": [
              "strategy"
            ],
            "properties": {
              "strategy": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "list",
                  "show",
                  "normalize",
                  "validate"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "request": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "StrategyValidation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "strategy": {
          "title": "Strategy",
          "type": "string"
        },
        "scope": {
          "const": "entrypoint_and_helpers",
          "default": "entrypoint_and_helpers",
          "title": "Scope",
          "type": "string"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "error_count": {
          "minimum": 0,
          "title": "Error Count",
          "type": "integer"
        },
        "warning_count": {
          "minimum": 0,
          "title": "Warning Count",
          "type": "integer"
        },
        "diagnostics": {
          "const": "details_omitted",
          "default": "details_omitted",
          "title": "Diagnostics",
          "type": "string"
        },
        "readiness": {
          "const": "not_checked",
          "default": "not_checked",
          "title": "Readiness",
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "valid",
        "error_count",
        "warning_count"
      ],
      "title": "StrategyValidation",
      "type": "object"
    },
    "StrategyView": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "strategy": {
          "title": "Strategy",
          "type": "string"
        },
        "scope": {
          "const": "authorized_strategy_view",
          "default": "authorized_strategy_view",
          "title": "Scope",
          "type": "string"
        },
        "configuration_verified": {
          "const": false,
          "default": false,
          "title": "Configuration Verified",
          "type": "boolean"
        },
        "tree": {
          "additionalProperties": true,
          "title": "Tree",
          "type": "object"
        },
        "trees": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Trees",
          "type": "object"
        },
        "dispatchable": {
          "items": {
            "type": "string"
          },
          "title": "Dispatchable",
          "type": "array"
        },
        "omitted": {
          "minimum": 0,
          "title": "Omitted",
          "type": "integer"
        },
        "interpretation": {
          "const": "structural_view_not_executable_configuration",
          "default": "structural_view_not_executable_configuration",
          "title": "Interpretation",
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "tree",
        "trees",
        "dispatchable",
        "omitted"
      ],
      "title": "StrategyView",
      "type": "object"
    },
    "ToolError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "memory_limit",
            "worker_monitor_failed",
            "os_permission_denied",
            "configuration_required",
            "engine_identity_unavailable",
            "access_denied",
            "input_not_found",
            "unsupported_format",
            "password_required",
            "input_too_large",
            "extraction_too_large",
            "no_readable_text",
            "busy",
            "timeout",
            "cancelled",
            "storage_limit",
            "parse_failed",
            "artifact_not_found",
            "artifact_corrupt",
            "artifact_version_unsupported",
            "evidence_not_found",
            "invalid_cursor",
            "response_too_large"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 256,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ToolError",
      "type": "object"
    },
    "ParseRequest": {
      "title": "ParseRequest",
      "type": "object",
      "required": [
        "document",
        "backend"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.3"
        },
        "document": {
          "type": "object",
          "description": "A relative source reference beneath the operator's input grant.",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "mime_type": {
              "type": "string",
              "examples": [
                "application/pdf",
                "image/png",
                "image/tiff",
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
              ]
            },
            "filename": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        },
        "backend": {
          "type": "object",
          "required": [],
          "description": "Which backend to run, and how it is provisioned. Encodes the four BYO modes.",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ],
              "description": "A backend id, or `strategy:<name>`. `auto` is gone: it asked the engine to infer, and selection is now the backend you name, else policy.backends in order, else pymupdf."
            },
            "type": {
              "enum": [
                "hosted_api",
                "oss_library",
                "framework_loader",
                "self_hosted_model"
              ]
            },
            "operation": {
              "type": "string",
              "description": "Sub-operation when a backend has several. Textract: DetectDocumentText|AnalyzeDocument|AnalyzeExpense|AnalyzeID|AnalyzeLending. Docling: default|vlm. LlamaParse tier: fast|cost_effective|agentic|agentic_plus."
            },
            "version": {
              "type": "string",
              "description": "Pin the backend/model version (LlamaParse 'version', model weights tag, library version)."
            }
          }
        },
        "outputs": {
          "type": "object",
          "description": "Desired output channels. The adapter fills what the backend supports and reports the rest in response.warnings.",
          "additionalProperties": false,
          "properties": {
            "markdown": {
              "type": "boolean",
              "default": true
            },
            "text": {
              "type": "boolean",
              "default": true
            },
            "blocks": {
              "type": "boolean",
              "default": true,
              "description": "Reading-order typed blocks with optional bbox/confidence (the common spine). Impossible for pure typed-field APIs and un-prompted token-stream LLMs."
            },
            "typed_fields": {
              "type": "boolean",
              "default": false
            },
            "tables": {
              "enum": [
                "none",
                "cells",
                "markdown",
                "html"
              ],
              "default": "markdown"
            },
            "chunking": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "strategy": {
                  "enum": [
                    "none",
                    "by_page",
                    "by_title",
                    "by_section",
                    "by_similarity",
                    "fixed"
                  ],
                  "default": "none"
                },
                "max_characters": {
                  "type": "integer",
                  "minimum": 1
                },
                "overlap": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "include_backend_raw": {
              "type": "boolean",
              "default": true,
              "description": "Return the untouched native payload / serialized native object (see §5). Off by default for high-volume callers who only want normalized."
            }
          }
        },
        "extraction_schema": {
          "type": "object",
          "description": "Custom typed extraction (P2/P6). A JSON Schema describing the fields to pull. Routed to /extract (Reducto, Chunkr), documents[].fields via queryFields (Azure), QUERIES (Textract, degraded), Structured Outputs (OpenAI/Gemini/Claude), document_annotation (Mistral). Backends that cannot do schema extraction return a warning.",
          "additionalProperties": false,
          "properties": {
            "json_schema": {
              "type": "object",
              "description": "Draft 2020-12 subset the target supports. Deliberately left open (no `properties`/`additionalProperties` of its own): this value IS an arbitrary caller-supplied JSON Schema, not a field this contract shapes (M12)."
            },
            "instructions": {
              "type": "string",
              "description": "System prompt / extraction guidance for LLM-based extractors."
            },
            "citations": {
              "type": "boolean",
              "default": false,
              "description": "Request per-field source grounding (page + bbox) where supported (Reducto, Chunkr, Claude page citations)."
            }
          }
        },
        "features": {
          "type": "object",
          "description": "Capability flags. Adapter maps to native toggles; unsupported flags → response.warnings, never a hard error.",
          "additionalProperties": false,
          "properties": {
            "ocr": {
              "enum": [
                "auto",
                "force",
                "off"
              ],
              "default": "auto",
              "description": "off = born-digital only (Docling do_ocr=False, pypdf/pymupdf). force = always rasterize+OCR."
            },
            "ocr_languages": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "ISO codes; e.g. ['en'] Tesseract, Textract 6 Latin only."
            },
            "layout": {
              "type": "boolean",
              "default": true
            },
            "reading_order": {
              "type": "boolean",
              "default": true
            },
            "tables": {
              "type": "boolean",
              "default": true
            },
            "forms_key_value": {
              "type": "boolean",
              "default": false
            },
            "figures_images": {
              "type": "boolean",
              "default": false
            },
            "signatures": {
              "type": "boolean",
              "default": false
            },
            "classification": {
              "type": "boolean",
              "default": false
            },
            "handwriting": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "pages": {
          "type": "object",
          "description": "Page selection. Normalizer applies 1-based inclusive ranges before/after backend call depending on whether the backend supports native page ranges.",
          "additionalProperties": false,
          "properties": {
            "ranges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "start"
                ]
              }
            },
            "max_pages": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "routing": {
          "type": "object",
          "description": "Hints for the router when backend.id is a class rather than a concrete backend, or for fallback.",
          "additionalProperties": false,
          "properties": {
            "doc_type_hint": {
              "enum": [
                "bank_statement",
                "paystub",
                "w2",
                "1003_loan_app",
                "1040_tax",
                "invoice",
                "id_document",
                "medical_form",
                "clinical_pdf",
                "generic"
              ]
            },
            "fallback": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Ordered backend ids to try if the primary fails or violates a compliance constraint."
            }
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/StrategyRequest"
    },
    {
      "$ref": "#/$defs/StrategyList"
    },
    {
      "$ref": "#/$defs/StrategyValidation"
    },
    {
      "$ref": "#/$defs/StrategyView"
    },
    {
      "$ref": "#/$defs/ExecutionToolFailure"
    },
    {
      "$ref": "#/$defs/ErrorEnvelope"
    }
  ],
  "title": "OpenReading Strategy Tool v0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openreading.ai/schemas/strategy-tool.v0.1.json"
}
