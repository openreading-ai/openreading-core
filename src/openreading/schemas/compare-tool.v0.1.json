{
  "$defs": {
    "CompareFailure": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "error": {
          "$ref": "#/$defs/CompareFault"
        }
      },
      "required": [
        "error"
      ],
      "title": "CompareFailure",
      "type": "object"
    },
    "CompareFault": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "invalid_comparison",
            "comparison_failed"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "const": false,
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "CompareFault",
      "type": "object"
    },
    "CompareReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "result_id": {
          "pattern": "^orr1_[0-9a-f]{64}$",
          "title": "Result Id",
          "type": "string"
        },
        "kind": {
          "const": "comparison_report",
          "default": "comparison_report",
          "title": "Kind",
          "type": "string"
        },
        "content_bytes": {
          "minimum": 1,
          "title": "Content Bytes",
          "type": "integer"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "result_id",
        "content_bytes",
        "content_sha256"
      ],
      "title": "CompareReceipt",
      "type": "object"
    },
    "CompareRequest": {
      "additionalProperties": false,
      "properties": {
        "result_ids": {
          "items": {
            "pattern": "^(or1|orr1)_[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 2,
          "title": "Result Ids",
          "type": "array"
        },
        "baseline": {
          "anyOf": [
            {
              "pattern": "^(or1|orr1)_[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline"
        }
      },
      "required": [
        "result_ids"
      ],
      "title": "CompareRequest",
      "type": "object"
    },
    "ErrorEnvelope": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.3",
          "default": "0.3",
          "title": "Schema Version",
          "type": "string"
        },
        "error": {
          "$ref": "#/$defs/ToolError"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorEnvelope",
      "type": "object"
    },
    "ResultFailure": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "error": {
          "$ref": "#/$defs/ResultFault"
        }
      },
      "required": [
        "error"
      ],
      "title": "ResultFailure",
      "type": "object"
    },
    "ResultFault": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "result_not_found",
            "result_corrupt",
            "invalid_result"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "const": false,
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ResultFault",
      "type": "object"
    },
    "ToolError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "memory_limit",
            "worker_monitor_failed",
            "os_permission_denied",
            "configuration_required",
            "engine_identity_unavailable",
            "access_denied",
            "input_not_found",
            "unsupported_format",
            "password_required",
            "input_too_large",
            "extraction_too_large",
            "no_readable_text",
            "busy",
            "timeout",
            "cancelled",
            "storage_limit",
            "parse_failed",
            "artifact_not_found",
            "artifact_corrupt",
            "artifact_version_unsupported",
            "evidence_not_found",
            "invalid_cursor",
            "response_too_large"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 256,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ToolError",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/CompareRequest"
    },
    {
      "$ref": "#/$defs/CompareReceipt"
    },
    {
      "$ref": "#/$defs/CompareFailure"
    },
    {
      "$ref": "#/$defs/ResultFailure"
    },
    {
      "$ref": "#/$defs/ErrorEnvelope"
    }
  ],
  "title": "OpenReading Compare Tool v0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openreading.ai/schemas/compare-tool.v0.1.json"
}
