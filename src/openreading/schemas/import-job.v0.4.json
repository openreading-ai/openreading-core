{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openreading.ai/schemas/import-job.v0.4.json",
  "$defs": {
    "ImportReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "0.4",
          "enum": [
            "0.3",
            "0.4",
            "0.5"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^or1_[0-9a-f]{64}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "page_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Count"
        },
        "passage_count": {
          "minimum": 0,
          "title": "Passage Count",
          "type": "integer"
        },
        "reused": {
          "title": "Reused",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "enum": [
              "source_changed",
              "parser_warnings_present",
              "no_matches"
            ],
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "next_action": {
          "default": "search",
          "enum": [
            "search",
            "get_document"
          ],
          "title": "Next Action",
          "type": "string"
        },
        "extraction_state": {
          "anyOf": [
            {
              "enum": [
                "succeeded",
                "partial"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extraction State"
        }
      },
      "required": [
        "artifact_id",
        "display_name",
        "document_sha256",
        "passage_count",
        "reused",
        "warnings"
      ],
      "title": "ImportReceipt",
      "type": "object"
    },
    "ToolError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "memory_limit",
            "worker_monitor_failed",
            "os_permission_denied",
            "configuration_required",
            "engine_identity_unavailable",
            "access_denied",
            "input_not_found",
            "unsupported_format",
            "password_required",
            "input_too_large",
            "extraction_too_large",
            "no_readable_text",
            "busy",
            "timeout",
            "cancelled",
            "storage_limit",
            "parse_failed",
            "artifact_not_found",
            "artifact_corrupt",
            "artifact_version_unsupported",
            "evidence_not_found",
            "invalid_cursor",
            "response_too_large"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 256,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ToolError",
      "type": "object"
    },
    "StartRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "StatusRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^j1_[0-9a-f]{32}$"
        },
        "wait_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "default": 0
        }
      }
    },
    "CancelRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^j1_[0-9a-f]{32}$"
        }
      }
    },
    "ImportJob": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "0.3",
          "enum": [
            "0.2",
            "0.3",
            "0.4"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "pattern": "^j1_[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        },
        "stage": {
          "enum": [
            "queued",
            "copying",
            "preflight",
            "conversion",
            "writing",
            "complete",
            "stopped"
          ],
          "title": "Stage",
          "type": "string"
        },
        "elapsed_seconds": {
          "minimum": 0,
          "title": "Elapsed Seconds",
          "type": "number"
        },
        "cancel_requested": {
          "default": false,
          "title": "Cancel Requested",
          "type": "boolean"
        },
        "page_progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/PageProgress"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImportReceipt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "job_id",
        "state",
        "stage",
        "elapsed_seconds"
      ],
      "title": "ImportJob",
      "type": "object"
    },
    "JobFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "enum": [
                "job_not_found",
                "job_start_failed",
                "job_state_invalid"
              ]
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "const": false
            }
          }
        }
      }
    },
    "ListRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512,
          "default": null
        }
      }
    },
    "ImportJobSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "state",
        "elapsed_seconds"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^j1_[0-9a-f]{32}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "unavailable"
          ]
        },
        "elapsed_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "ImportJobList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobs"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1",
          "default": "0.1"
        },
        "jobs": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/ImportJobSummary"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512,
          "default": null
        }
      }
    },
    "PageProgress": {
      "additionalProperties": false,
      "properties": {
        "pages_assembled": {
          "minimum": 0,
          "title": "Pages Assembled",
          "type": "integer"
        },
        "total_pages": {
          "minimum": 1,
          "title": "Total Pages",
          "type": "integer"
        }
      },
      "required": [
        "pages_assembled",
        "total_pages"
      ],
      "title": "PageProgress",
      "type": "object"
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ImportJob"
    },
    {
      "$ref": "#/$defs/JobFailure"
    },
    {
      "$ref": "#/$defs/ImportJobList"
    }
  ]
}
