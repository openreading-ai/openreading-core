{
  "$defs": {
    "AttributedResultProvenance": {
      "additionalProperties": false,
      "description": "Comparison attribution supplements the legacy aggregate without upgrading its claims.",
      "properties": {
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "core_version": {
          "minLength": 1,
          "title": "Core Version",
          "type": "string"
        },
        "core_commit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Core Commit"
        },
        "adapters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Adapters",
          "type": "object"
        },
        "source_sha256": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Sha256",
          "type": "array"
        },
        "subjects": {
          "additionalProperties": {
            "pattern": "^(or1|orr1)_[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Subjects",
          "type": "object"
        },
        "subject_sources": {
          "additionalProperties": {
            "$ref": "#/$defs/SubjectSource"
          },
          "title": "Subject Sources",
          "type": "object"
        }
      },
      "required": [
        "request_sha256",
        "config_sha256",
        "core_version",
        "core_commit",
        "adapters",
        "source_sha256",
        "subjects",
        "subject_sources"
      ],
      "title": "AttributedResultProvenance",
      "type": "object"
    },
    "JsonValue": {},
    "ResultContent": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "normalized_response"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "https://openreading.ai/schemas/response/v0.3.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "comparison_report"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "https://openreading.ai/schemas/comparison-report.v0.2.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "batch_result"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "https://openreading.ai/schemas/batch-result.v0.2.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "corpus_report"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "https://openreading.ai/schemas/corpus-report.v0.1.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "corpus_report"
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "not": {
                  "required": [
                    "truth"
                  ]
                },
                "required": [
                  "subject_sources"
                ]
              },
              "payload": {
                "properties": {
                  "documents": {
                    "items": {
                      "properties": {
                        "report": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "$ref": "https://openreading.ai/schemas/comparison-report.v0.2.json"
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "batch_result"
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "not": {
                  "required": [
                    "subject_sources"
                  ]
                },
                "properties": {
                  "subjects": {
                    "maxProperties": 0
                  }
                }
              },
              "payload": {
                "properties": {
                  "items": {
                    "items": {
                      "properties": {
                        "response": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "$ref": "https://openreading.ai/schemas/response/v0.3.json",
                              "not": {
                                "required": [
                                  "backend_raw"
                                ]
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "description": "Complete normalized values with their producer identity, without backend_raw.",
      "properties": {
        "kind": {
          "enum": [
            "normalized_response",
            "comparison_report",
            "batch_result",
            "corpus_report"
          ],
          "title": "Kind",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoredResultProvenance"
            },
            {
              "$ref": "#/$defs/AttributedResultProvenance"
            },
            {
              "$ref": "#/$defs/ResultProvenance"
            }
          ],
          "title": "Provenance"
        },
        "payload": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "provenance",
        "payload"
      ],
      "title": "ResultContent",
      "type": "object"
    },
    "ResultProvenance": {
      "additionalProperties": false,
      "description": "Explicit producer assertions, with configuration values represented only by fingerprints.",
      "properties": {
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "core_version": {
          "minLength": 1,
          "title": "Core Version",
          "type": "string"
        },
        "core_commit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Core Commit"
        },
        "adapters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Adapters",
          "type": "object"
        },
        "source_sha256": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Sha256",
          "type": "array"
        },
        "subjects": {
          "additionalProperties": {
            "pattern": "^(or1|orr1)_[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Subjects",
          "type": "object"
        }
      },
      "required": [
        "request_sha256",
        "config_sha256",
        "core_version",
        "core_commit",
        "adapters",
        "source_sha256",
        "subjects"
      ],
      "title": "ResultProvenance",
      "type": "object"
    },
    "ScoredResultProvenance": {
      "additionalProperties": false,
      "description": "Caller-supplied expected values retained exactly, without an independent truth claim.",
      "properties": {
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "core_version": {
          "minLength": 1,
          "title": "Core Version",
          "type": "string"
        },
        "core_commit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Core Commit"
        },
        "adapters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Adapters",
          "type": "object"
        },
        "source_sha256": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Sha256",
          "type": "array"
        },
        "subjects": {
          "additionalProperties": {
            "pattern": "^(or1|orr1)_[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Subjects",
          "type": "object"
        },
        "subject_sources": {
          "additionalProperties": {
            "$ref": "#/$defs/SubjectSource"
          },
          "title": "Subject Sources",
          "type": "object"
        },
        "truth": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "description": "Exact expected values supplied by the caller to the shared scorer. The record digest binds these values; no independent truth verification is claimed.",
          "title": "Truth",
          "type": "object"
        }
      },
      "required": [
        "request_sha256",
        "config_sha256",
        "core_version",
        "core_commit",
        "adapters",
        "source_sha256",
        "subjects",
        "subject_sources",
        "truth"
      ],
      "title": "ScoredResultProvenance",
      "type": "object"
    },
    "SubjectSource": {
      "additionalProperties": false,
      "description": "Source hashes attributed to one subject, with the producer's verification basis.",
      "properties": {
        "source_sha256": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Sha256",
          "type": "array"
        },
        "verification": {
          "description": "verified_source_bytes means the retained source copy was rehashed against its manifest digest when the comparison producer loaded it. It does not check whether the user's original file still matches or establish that subjects share a document. producer_asserted preserves the normalized-response producer's hash claims without independent source-byte verification. Reading a retained comparison does not rehash its subjects' source copies again.",
          "enum": [
            "verified_source_bytes",
            "producer_asserted"
          ],
          "title": "Verification",
          "type": "string"
        }
      },
      "required": [
        "source_sha256",
        "verification"
      ],
      "title": "SubjectSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "format": {
            "const": "retained-result.v0.1"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "properties": {
              "kind": {
                "enum": [
                  "normalized_response",
                  "comparison_report"
                ]
              },
              "provenance": {
                "not": {
                  "required": [
                    "subject_sources"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "format": {
            "const": "retained-result.v0.2"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "properties": {
              "kind": {
                "const": "comparison_report"
              },
              "provenance": {
                "not": {
                  "required": [
                    "truth"
                  ]
                },
                "required": [
                  "subject_sources"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "format": {
            "const": "retained-result.v0.3"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "properties": {
              "kind": {
                "const": "batch_result"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "format": {
            "const": "retained-result.v0.4"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "oneOf": [
              {
                "properties": {
                  "kind": {
                    "const": "comparison_report"
                  },
                  "provenance": {
                    "required": [
                      "truth",
                      "subject_sources"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "kind": {
                    "const": "corpus_report"
                  },
                  "provenance": {
                    "not": {
                      "required": [
                        "truth"
                      ]
                    },
                    "required": [
                      "subject_sources"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "format": {
      "default": "retained-result.v0.4",
      "enum": [
        "retained-result.v0.1",
        "retained-result.v0.2",
        "retained-result.v0.3",
        "retained-result.v0.4"
      ],
      "title": "Format",
      "type": "string"
    },
    "input_grant_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Grant Sha256",
      "type": "string"
    },
    "content": {
      "$ref": "#/$defs/ResultContent"
    }
  },
  "required": [
    "input_grant_sha256",
    "content"
  ],
  "title": "ResultRecord",
  "type": "object",
  "$id": "https://openreading.ai/schemas/retained-result.v0.4.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
