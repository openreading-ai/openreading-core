# Claude Code writes one per-user settings file, and this repository ships CLAUDE.md.
.claude/settings.local.json

# The README and the subsystem guides redirect their output into the clone root, which leaves
# names like pymupdf.json, sample.pdf, openreading.yaml, run.log and .openreading/ behind.
# None of it is source, so a newcomer sees a clean `git status` after a first parse.
# A new root file that one of these patterns covers needs `git add -f` to be tracked.
/*.json
/*.pdf
/*.yaml
/*.txt
/*.log
/.openreading/
/benchmark-results/

# Your own test corpus, and every batch or compare output it produces (samples/.runs/*.json).
# Put the documents you want to try under samples/, then run scripts/batch_demo.sh.
samples/

# This directory holds working documents: design specs, implementation plans, scratch notes.
# It is not tracked, and that is deliberate. Documentation that describes the system lives in
# the code as a module docstring, so it sits next to what it describes and goes stale loudly
# instead of quietly (AGENTS.md). Anything here worth keeping is distilled into a module
# docstring, or moved to the private `openreading` company repo (design/, runs/, research/),
# never committed as a file here.
/docs/

# Local git worktrees for isolated feature work.
/.worktrees/
