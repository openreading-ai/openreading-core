# OpenReading BYO credentials. This file is a reference list, not a file to copy.
# Do NOT run `cp .env.example .env`. Write only the backends you hold, one line at a time:
#
#     echo 'REDUCTO_API_KEY=sk_...' >> .env
#
# `.env` is in this repo's .gitignore, so a file written inside a clone is not committed. Your
# shell still records that line, which puts the key in ~/.zsh_history or ~/.bash_history in plain
# text; type it into an editor instead if that matters to you.
#
# Copying changes which backend reads your document. QWEN_VL_ENDPOINT and DOCLING_SERVE_URL below
# ship with a value rather than blank, so a copy marks docling and qwen-vl CONFIGURED on a machine
# where neither is running. Under a `require_local` policy the router then sends your scan to
# http://localhost:5001, and the envelope records `docling TerminalError (ConnectError)`. Without
# the copy it records `docling skipped (missing_credentials)` and the document never reaches a
# socket.
#
# OpenReading NEVER stores these server-side; they are resolved per request from the caller's
# environment via the credential broker (BYO-key posture). `.env` is auto-loaded by the CLI/server
# and never overrides an already-set process env (an exported shell var beats this file). The
# full resolution order, per-backend table and failure posture: `openreading.credentials`.
#
# An OPENREADING_<SLUG>_<KEY> form always overrides the service-native var below, e.g.
# OPENREADING_REDUCTO_API_KEY beats REDUCTO_API_KEY. pymupdf & tesseract need no keys (local).
#
# `make verify-live`'s per-backend live-test gate only checks that a var below is SET, not that
# its value is still reachable. Harmless for a hosted API key (a stale key just fails loudly, like
# any other auth error). But qwen-vl's QWEN_VL_ENDPOINT and docling's DOCLING_SERVE_URL below gate
# on a LOCAL SERVICE ADDRESS instead of a secret. If you're not actively running that local
# service, remove/comment the line before `make verify-live`, or its live test will attempt a real
# connection to a stale address instead of skipping.

# --- reducto (signup: https://platform.reducto.ai) ---
REDUCTO_API_KEY=
REDUCTO_WEBHOOK_SECRET=                 # Svix signing secret, only for inbound webhooks

# --- chunkr (signup: https://chunkr.ai) ---
CHUNKR_API_KEY=
CHUNKR_BASE_URL=                        # optional: self-hosted (AGPL) container, e.g. http://localhost:8000

# --- pulse (signup: https://www.runpulse.com) ---
PULSE_API_KEY=

# --- nuextract (signup: https://nuextract.ai ; the vendor SDK's NUMIND_API_KEY also works) ---
NUEXTRACT_API_KEY=
NUEXTRACT_BASE_URL=                     # optional: on-prem/enterprise platform deployment

# --- open-ocr (signup: https://open-ocr.com ; OCR aggregator, billed per page to your balance) ---
OPENOCR_API_KEY=
OPENOCR_ENGINE=                         # optional: engine id, default openocr/tesseract

# --- anthropic-claude (signup: https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                        # optional, default claude-opus-4-8

# --- aws-textract (signup: https://aws.amazon.com/textract/ ; BYO IAM, billed to your AWS account) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=                      # optional, only for STS/temporary credentials
AWS_REGION=us-east-1                    # AWS_DEFAULT_REGION is also honored
OPENREADING_TEXTRACT_S3_BUCKET=        # required only for the multi-page async POLL flow

# --- azure-document-intelligence (signup: https://azure.microsoft.com/products/ai-services/ai-document-intelligence) ---
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# --- google-document-ai (signup: https://cloud.google.com/document-ai ; BYO GCP project + ADC) ---
GOOGLE_APPLICATION_CREDENTIALS=         # path to a service-account JSON (ADC)
GCP_PROJECT_ID=
GCP_LOCATION=us
GCP_PROCESSOR_ID=

# --- qwen-vl (self-hosted OpenAI-compatible endpoint; no data leaves your infra) ---
# The next line carries a real value, not a blank. On its own it marks qwen-vl CONFIGURED.
QWEN_VL_ENDPOINT=http://localhost:8000/v1
QWEN_VL_MODEL=Qwen/Qwen3-VL-8B-Instruct
QWEN_VL_API_KEY=                        # optional, only if your endpoint requires auth

# --- docling (self-hosted docling-serve container; no data leaves your infra) ---
# The next line carries a real value, not a blank. On its own it marks docling CONFIGURED, and a
# scan under a `require_local` policy is then sent to this address.
DOCLING_SERVE_URL=http://localhost:5001

# ============================================================================================
# Operator knobs -- every OPENREADING_* variable that changes how the system BEHAVES rather than
# which vendor it talks to. All commented out: unset is the documented default for each. A knob is
# read where it is read (several are server-only or CLI-only; each line says which surface).
# Reader modules: openreading.api (ledger, URL fetch), openreading.strategies.loader / .decider
# (strategy), openreading.server.app (auth + compliance), openreading.credentials (broker).
# ============================================================================================

# --- server deployment knobs (openreading serve) ---
# Compliance posture: read ONLY by the server (server/app.py `_server_router_config`), from the
# deployment env, never from a request body (DECISIONS D7). The CLI and Python API ignore them.
# TRAIN_OPTOUT / BAA_TIER are ATTESTATIONS, not feature toggles: you assert paperwork exists
# outside the system; the router cannot verify that, which is why the default is to refuse.
# OPENREADING_ALLOW_UNVERIFIED_COMPLIANCE=false   # 1/true/yes = let UNVERIFIED compliance fields survive the
#                                                 #   router's compliance stage. Anything else (incl. unset) is
#                                                 #   fail-closed. One of the THREE knobs here that WIDEN the
#                                                 #   eligible set. The other two are the confirmed-slug lists
#                                                 #   below. Nothing downstream of the policy widens it again.
# OPENREADING_TRAIN_OPTOUT_CONFIRMED=             # comma-separated slugs whose no-train opt-out you've confirmed
#                                                 #   with the vendor (blanks dropped). Unset: pulse, nuextract,
#                                                 #   open-ocr (no-train UNVERIFIED) fail closed
# OPENREADING_BAA_TIER_CONFIRMED=                 # comma-separated slugs whose tier-gated BAA you've actually
#                                                 #   signed (e.g. reducto; blanks dropped); unset means
#                                                 #   `hipaa_baa: tier_gated` fails require_baa and is dropped
# Caller auth: read by server/app.py `_load_api_key_config`. Errors name the setting and the
# POSITION in the list, never the value, so a startup crash log stays safe to paste.
# OPENREADING_API_KEYS=                           # comma-separated bearer tokens. Unset/empty = caller auth OFF
#                                                 #   (every endpoint behaves exactly as with zero configuration).
#                                                 #   An empty entry (stray comma) is a hard startup failure --
#                                                 #   unlike the two lists above, a key is security-bearing and a
#                                                 #   quietly-dropped token would look configured when it is not.
#                                                 #   Configured: unknown/absent bearer -> 401 unauthorized
# OPENREADING_API_KEY_SCOPES=                     # comma-separated `token=backend1|backend2|...` entries, each
#                                                 #   narrowing one already-listed key to a backend allow-list.
#                                                 #   A key with no entry here is unscoped. Any malformed shape
#                                                 #   (empty entry / stray comma, missing '=', empty key or backend
#                                                 #   list, unknown key, duplicate, set while API_KEYS is empty)
#                                                 #   fails startup. Out-of-scope backend ->
#                                                 #   403 scope_denied, checked BEFORE any adapter is built or
#                                                 #   credential resolved
# document.path over HTTP: read PER REQUEST by server/app.py `_document_path_refusal`, independent
# of the caller-auth vars above -- this gate applies even with zero OPENREADING_API_KEYS configured.
# OPENREADING_SERVER_PATH_ROOT=                   # directory document.path may resolve beneath. Unset (default)
#                                                 #   = every document.path refused, on every caller-body ingress
#                                                 #   (HTTP turns a local field naming a file into a remote
#                                                 #   file-read primitive). Symlinks are resolved before
#                                                 #   containment is checked, so a link escaping this directory
#                                                 #   is refused like a literal '..'. The CLI/Python API ignore
#                                                 #   this var -- there the caller and the machine are the same
#                                                 #   trust domain, so document.path is unaffected
# Async job store bounds (M4): read by server/app.py `_sweep_jobs` / `submit_job`. Every record
# holds the FULL request (base64 document bytes, document.password included) until it is swept
# or deleted, so the store cannot grow without a limit. There is no scheduler thread -- sweeping
# is lazy, running at the top of every submit and GET call; a still-running record is never swept
# regardless of age, only a TERMINAL one past its TTL.
# OPENREADING_JOB_TTL_S=3600                      # seconds a TERMINAL record survives past its created_ms
#                                                 #   before the next store access sweeps it. Unset = 1 hour
# OPENREADING_MAX_ASYNC_JOBS=1000                 # hard cap on total records (any state). A submit at or
#                                                 #   over the cap is refused with 429 rate_limited before its
#                                                 #   body is parsed. DELETE /v1/jobs/{job_id} (204, or 404
#                                                 #   unknown) frees a slot immediately without waiting on the
#                                                 #   TTL. Unset = 1000
# OPENREADING_MAX_JOBS_PER_PRINCIPAL=100          # per-API-key allowance within that total, so one caller
#                                                 #   filling the store cannot 429 every other caller. Applies
#                                                 #   only when OPENREADING_API_KEYS is set (no keys = one
#                                                 #   anonymous principal, and only the global cap). Unset = 100
# OPENREADING_ALLOW_UNSIGNED_WEBHOOKS=1           # accept a chunkr/open-ocr callback WITHOUT the per-job token
#                                                 #   the server appended to the URL it registered -- i.e. on the
#                                                 #   vendor task id alone, which anyone who saw it can forge.
#                                                 #   For a vendor that strips query params. Unset = refuse (401)
# OPENREADING_MAX_COMPARE_BYTES=8388608           # ceiling on a POST /v1/compare body. Compare's cost is
#                                                 #   quadratic in the text it is given, so this is a tighter
#                                                 #   bound than MAX_BODY_BYTES. Over it = 400, never a
#                                                 #   truncated comparison. Unset = 8 MB
# OPENREADING_RETENTION_SWEEP_S=3600              # seconds between ledger retention sweeps while the server
#                                                 #   is serving; 0 disables the timer. Without it an idle
#                                                 #   server holds expired content past its ceiling. A
#                                                 #   malformed value fails startup. Unset = 1 hour

# Transport body cap (M2): read by server/app.py `_BodyLimitMiddleware`, a pure-ASGI middleware on
# every request regardless of path -- every endpoint does `await request.json()` with no
# framework-level limit otherwise, so an unauthenticated caller could hand the server an
# arbitrarily large body and have it fully buffered into memory before any handler runs. A
# declared Content-Length over the cap is refused with 413 before a single body byte is read; a
# chunked/undeclared-length body is cut off mid-stream instead (best-effort -- see the class
# docstring for why that leg cannot promise a clean 413 the way the declared-length one does).
# OPENREADING_MAX_BODY_BYTES=157286400            # bytes. Unset = 150 MiB (157286400): the 100 MB
#                                                 #   document cap (`doc_too_large`), base64-
#                                                 #   inflated by ~4/3, plus envelope headroom.

# --- document URL fetch (openreading.api._download) ---
# Read directly in _download, not server-only: any surface (CLI/API/server) that resolves a
# document.url through materialize_document hits this. Default (unset) refuses a URL whose host
# resolves to a loopback/private/link-local/reserved address (cloud metadata endpoints included)
# before the request ever leaves this process -- an unauthenticated caller handing this process a
# URL is otherwise a foothold to probe your own internal network / cloud metadata service on the
# process's behalf (SSRF). Pre-resolution check only; a DNS answer that changes between the check
# and the connect (rebinding) is out of scope here -- put egress policy in front if you need that.
# OPENREADING_ALLOW_PRIVATE_URLS=1                # allow document URLs resolving to private/loopback addresses
#                                                 #   (intranet stores)

# --- ledger execution plane (openreading parse / resume) ---
# Arming is env-only; there is no CLI flag. Point OPENREADING_LEDGER at a directory and every
# strategy-dispatch run writes `<run_id>.jsonl` there (the journal: one line per StepResult,
# append-only), alongside `blobs/` (payloads encrypted under a per-run key) and `keys/` (dir 0700,
# one 0600 file per run). Unset means a NullJournal and no blob store -- the zero-delta path,
# byte-for-byte as before. `openreading resume RUN_ID` (Python: `openreading.resume("r_...")`)
# takes no other flags and reads that run's own header; unset here is exit 3 (same code as an
# unknown RUN_ID). Ctrl-C on an ARMED run exits 6 (parked, resumable; a single-doc run prints its
# RUN_ID, a batch names none -- batch-level resume is out of scope, but the per-item runs under
# the ledger root may still be individually resumable); unarmed, an interrupt is an ordinary
# interrupt. Arming is read only on the strategy-dispatch path (`_run_strategy_request`
# and `resume`), so what journals: `--strategy <name>`, `defaults.strategy` in openreading.yaml,
# and POST /v1/parse resolving to a strategy (needs OPENREADING_CONFIG). What does NOT: a named
# `--backend`, `auto` with no defaults.strategy, `strategy:none`, POST /v1/jobs (in-memory, no
# server-side resume), and native `run_batch` (submit_many never calls run_request). A batch
# directory inherits whichever row its items resolve to (one run per item under `--strategy`).
# A named-backend deployment with OPENREADING_LEDGER set journals NOTHING while appearing armed.
# Back up `*.jsonl` and `blobs/`; NEVER back up `keys/` -- erasure works by destroying the per-run
# key (O(1) across every replica and backup at once), and holds only while no other copy of the
# key survives. A shredded run is permanently non-replayable by design: the journal still answers
# "what happened", just not "with what content". Readers: openreading.api, openreading.ledger.
# OPENREADING_LEDGER=./.openreading               # directory path; SET arms the journal
# OPENREADING_LEDGER_RETENTION_HOURS=24           # optional, default 24.0 (ledger/retention.py; a placeholder
#                                                 #   pending a founder decision). Read once at arm time and
#                                                 #   stamped on the run as `expires_epoch_ms`, an absolute UTC
#                                                 #   epoch from Clock.now_wall_ms, so it survives a reboot and
#                                                 #   the reaper still fires on the run afterwards.
#                                                 #   Only the run's STARTING ceiling: InlineExecutor tightens it
#                                                 #   per step from each DISPATCHED backend's descriptor field
#                                                 #   `max_retention_hours` and never widens it (an eligible-but-
#                                                 #   undispatched backend has no effect). A ZDR-flagged backend
#                                                 #   on the path => zero retention for the whole path: journal
#                                                 #   metadata only, no blob, no backend_raw, no page text. Raise
#                                                 #   it BEFORE the run if resume returns payload_expired -- once
#                                                 #   the key is reaped nothing brings the content back. Each arm
#                                                 #   runs a reaper sweep over the whole ledger root, and that arm
#                                                 #   is the ONLY trigger: nothing sweeps on a timer and there is
#                                                 #   no purge verb. So this value is the earliest moment a payload
#                                                 #   may be destroyed, never the moment it is, and a run whose
#                                                 #   window expired on Friday keeps its key and its document bytes
#                                                 #   all weekend if nothing else runs. When you owe someone a
#                                                 #   deletion deadline, schedule your own arm (a cron entry
#                                                 #   parsing anything with the ledger set fires the reaper), or
#                                                 #   delete that run's keys/ file yourself.

# --- strategy engine (openreading.yaml) ---
# OPENREADING_CONFIG=                             # explicit strategy-file path. Discovery order, first hit wins:
#                                                 #   --config / config= > this var > ./openreading.yaml (the last
#                                                 #   is CLI + Python only; the server passes allow_cwd=False and
#                                                 #   never sniffs its cwd, so this is the only non-flag way to
#                                                 #   load a strategy file under `openreading serve`). Never
#                                                 #   merged. Nothing found -> load_config() is None and the
#                                                 #   strategy package is not even imported
# OPENREADING_LLM_DECIDER=                        # second enablement key for the LLM decider. 1/true/yes/on
#                                                 #   enables it; a backend id both enables it and overrides
#                                                 #   `decider.llm.backend`. Unset means configured decisions
#                                                 #   downgrade with reason `env_disabled` (0/false/no/off too).
#                                                 #   Deliberate: a checked-in YAML must not start spending LLM
#                                                 #   tokens without separate operator consent at the env layer.
#                                                 #   Other downgrade reasons: unavailable (enabled and eligible,
#                                                 #   but no LLM executor port is wired into this runtime, or the
#                                                 #   backend id is unknown to the registry), compliance (the
#                                                 #   decider backend was dropped by the request's compliance
#                                                 #   filter), timeout (reserved -- the engine applies no per-call
#                                                 #   deadline yet), malformed (output fails schema / engine
#                                                 #   re-validation, or the port raised), refusal (the model
#                                                 #   declines to choose)

# --- credential broker ---
# OPENREADING_CREDENTIALS_REF_ALIASES=            # comma-separated env prefixes that a request's
#                                                 #   `credentials_ref: "env:<alias>"` is allowed to select.
#                                                 #   Unset/empty accepts no alias at all (fails closed). Why: a
#                                                 #   free-form prefix let an unauthenticated request read any
#                                                 #   env var shaped <PREFIX>_<KEY>. Leave unset unless you are
#                                                 #   deliberately exposing named credential slots to callers.
#                                                 #   E.g. TEAM_A,TEAM_B -> `env:TEAM_A` reads TEAM_A_API_KEY
# Backend-specific config: OPENREADING_TEXTRACT_S3_BUCKET lives in the aws-textract block above --
# needed only for the multi-page async POLL flow (sync is 1 page; async <=3000 pages via S3).

# --- dev / test only ---
# OPENREADING_RECORD_FIXTURES=1                   # with `make verify-live`, also write secret-scrubbed real
#                                                 #   responses back into the offline fixtures (how mocks are
#                                                 #   refreshed after a vendor changes shape; the adapter checklist
#                                                 #   needs one such run via CLI and server). NEVER set for an
#                                                 #   ordinary run: it rewrites checked-in fixtures

# --- specified, not wired (no reader in src/; absent above on purpose -- setting one does nothing) ---
# OPENREADING_MCP_MAX_ITEMS, OPENREADING_MCP_OUT
# OPENREADING_DECIDER_EXECUTOR, OPENREADING_DECIDER_MODEL
#   (DECIDER_MODEL is the decider's OWN model selector, deliberately distinct from ANTHROPIC_MODEL,
#   which belongs to the parse adapter)
